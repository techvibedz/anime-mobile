{
  "expo": {
    "name": "Pantoufa",
    "slug": "injaz",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "anime-mobile",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#080c25"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anime.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080c25"
      },
      "package": "com.anime.mobile",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/54f0baee-f81b-4de2-89f1-825251f0547d"
    },
    "runtimeVersion": "2.0.0",
    "extra": {
      "versionJsonUrl": "https://raw.githubusercontent.com/techvibedz/anime-mobile/master/version.json",
      "router": {},
      "eas": {
        "projectId": "54f0baee-f81b-4de2-89f1-825251f0547d"
      }
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-asset",
      "expo-video",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#FF2D55"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق إلى الوصول إلى صورك لإرفاق لقطة شاشة بالبلاغ."
        }
      ],
      "./plugins/withAndroidDoH"
    ],
    "owner": "houdeifa515"
  }
}
